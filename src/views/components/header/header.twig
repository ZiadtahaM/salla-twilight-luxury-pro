<header role="banner" class="luxury-header sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">

    {# ── Start: Logo + Navigation ── #}
    <div class="flex items-center gap-3 sm:gap-8">

      {# Mobile Menu Trigger #}
      <button type="button"
        data-menu-trigger
        class="md:hidden p-2 text-luxury-text hover:text-luxury-primary focus-visible:ring-2 focus-visible:ring-luxury-accent rounded-none"
        aria-label="{{ trans('common.menu')|default('القائمة') }}"
        aria-expanded="false"
        aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

      {# Store Logo #}
      <a href="{{ store.url }}" class="flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-luxury-accent" aria-label="{{ store.name }}">
        {% if store.logo %}
          <img src="{{ store.logo }}" alt="{{ store.name }}" class="h-8 sm:h-10 w-auto object-contain" width="140" height="40" loading="eager" fetchpriority="high">
        {% else %}
          <span class="text-lg sm:text-2xl font-bold tracking-tight text-luxury-text whitespace-nowrap font-display">{{ store.name }}</span>
        {% endif %}
      </a>

      {# Desktop Navigation #}
      <nav role="navigation" aria-label="{{ trans('common.main_navigation')|default('التنقل الرئيسي') }}" class="hidden md:flex items-center gap-6">
        <ul class="flex items-center gap-6 list-none m-0 p-0 text-sm font-medium">
          <li><a href="{{ link('home')|default('/') }}" class="text-luxury-muted hover:text-luxury-text transition-colors duration-200">{{ trans('common.home')|default('الرئيسية') }}</a></li>
          <li><a href="{{ link('categories')|default('/categories') }}" class="text-luxury-muted hover:text-luxury-text transition-colors duration-200">{{ trans('common.categories')|default('المجموعات') }}</a></li>
          <li><a href="{{ link('offers')|default('/offers') }}" class="text-luxury-muted hover:text-luxury-text transition-colors duration-200">{{ trans('common.offers')|default('العروض') }}</a></li>
        </ul>
      </nav>
    </div>

    {# ── End: Actions ── #}
    <div class="flex items-center gap-2 sm:gap-3">

      {# Search trigger — Salla native component #}
      <salla-search class="hidden sm:flex" aria-label="{{ trans('common.search')|default('بحث') }}"></salla-search>

      {# Language Switcher #}
      <a href="{{ user.language.code == 'ar' ? '?lang=en' : '?lang=ar' }}"
        class="text-[11px] uppercase tracking-wider px-2 py-1 border border-luxury-border hover:border-luxury-primary transition-colors duration-200 hidden sm:flex"
        lang="{{ user.language.code == 'ar' ? 'en' : 'ar' }}">
        {{ user.language.code == 'ar' ? 'EN' : 'عر' }}
      </a>

      {# Cart — Salla native web component handles count badge and drawer #}
      <salla-cart-summary aria-label="{{ trans('common.cart')|default('السلة') }}"></salla-cart-summary>

      {# Account link #}
      <a href="{{ user.is_logged_in ? link('profile')|default('/profile') : link('login')|default('/login') }}"
        class="p-2 sm:px-3 sm:py-2 text-xs uppercase tracking-widest border border-luxury-border hover:border-luxury-primary transition-colors duration-200 flex items-center gap-1.5"
        aria-label="{{ user.is_logged_in ? trans('common.my_account')|default('حسابي') : trans('common.login')|default('دخول') }}">
        <svg class="w-4 h-4 text-luxury-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <span class="hidden sm:inline">{{ user.is_logged_in ? (user.name|split(' ')|first|default('حسابي')) : trans('common.login')|default('دخول') }}</span>
      </a>
    </div>
  </div>

  {# ── Mobile Sliding Menu ── #}
  <div id="mobile-menu"
    data-mobile-menu
    class="fixed inset-y-0 {{ user.language.dir == 'rtl' ? 'right-0 translate-x-full' : 'left-0 -translate-x-full' }} w-72 bg-luxury-surface z-50 transform transition-transform duration-300 ease-elastic md:hidden overflow-y-auto"
    aria-hidden="true">
    <div class="p-6">
      <div class="flex items-center justify-between mb-8">
        <span class="text-lg font-display font-semibold text-luxury-text">{{ store.name }}</span>
        <button type="button" data-menu-trigger aria-label="{{ trans('common.close')|default('إغلاق') }}" class="p-1 text-luxury-muted hover:text-luxury-text">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <nav>
        <ul class="space-y-4 text-sm font-medium">
          <li><a href="{{ link('home')|default('/') }}" class="block text-luxury-text hover:text-luxury-accent transition-colors py-2 border-b border-luxury-border">{{ trans('common.home')|default('الرئيسية') }}</a></li>
          <li><a href="{{ link('categories')|default('/categories') }}" class="block text-luxury-text hover:text-luxury-accent transition-colors py-2 border-b border-luxury-border">{{ trans('common.categories')|default('المجموعات') }}</a></li>
          <li><a href="{{ link('offers')|default('/offers') }}" class="block text-luxury-text hover:text-luxury-accent transition-colors py-2 border-b border-luxury-border">{{ trans('common.offers')|default('العروض') }}</a></li>
          <li><a href="{{ user.is_logged_in ? link('profile')|default('/profile') : link('login')|default('/login') }}" class="block text-luxury-text hover:text-luxury-accent transition-colors py-2">{{ user.is_logged_in ? trans('common.my_account')|default('حسابي') : trans('common.login')|default('تسجيل الدخول') }}</a></li>
        </ul>
      </nav>
    </div>
  </div>

  {# Mobile menu overlay #}
  <div data-menu-overlay class="fixed inset-0 bg-black/50 z-40 hidden md:hidden" aria-hidden="true"></div>
</header>
