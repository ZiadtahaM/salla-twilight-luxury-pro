{#
  Component: Luxury Hero Banner 2.0
  Path: src/views/components/home/luxury-hero-banner.twig
#}

{% set banner = component.fields|default({}) %}
{% set overlay_alpha = (banner.overlay_opacity|default(50)) / 100 %}

<section aria-label="{{ banner.title|default('مجموعة الرفاهية الاستثنائية') }}" class="lux-hero">
  {# Background Image #}
  <img 
    src="{{ banner.desktop_image|default(banner.mobile_image)|default('https://images.unsplash.com/photo-1547949003-9792a18a2601?q=80&w=1920&auto=format&fit=crop') }}" 
    alt="{{ banner.image_alt|default(banner.title)|default('صورة الواجهة الرئيسية الفاخرة') }}" 
    class="lux-hero-bg"
    loading="eager"
    fetchpriority="high"
    width="1920"
    height="1080"
  >

  {# Contrast Scrim #}
  <div class="lux-hero-scrim" style="opacity: {{ overlay_alpha }};"></div>

  {# Content #}
  <div class="lux-container">
    <div class="lux-hero-content">
      <span class="lux-eyebrow">
        {{ banner.eyebrow|default('تصميم حصري 2026') }}
      </span>

      <h1 class="lux-hero-title">
        {{ banner.title|default('مجموعة الرفاهية الاستثنائية') }}
      </h1>

      <p class="lux-hero-subtitle">
        {{ banner.subtitle|default('حرفية استثنائية وتفاصيل حصرية مصممة لتواكب ذوقك الرفيع في عالم الأناقة المعاصرة') }}
      </p>

      <div>
        <a href="{{ banner.cta_url|default('/categories') }}" class="lux-cta-btn">
          <span>{{ banner.cta_label|default('اكتشف التشكيلة الحصرية') }}</span>
          <span>&larr;</span>
        </a>
      </div>
    </div>
  </div>
</section>
