<!DOCTYPE html>
<html lang="{{ language.code|default('ar') }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ store.name }} | {% block title %}{{ page.title|default('المتجر الرسمي') }}{% endblock %}</title>

  {# ── Salla platform lifecycle hooks (head) ── #}
  {% hook 'head:start' %}
  {% hook head %}

  {# Google Fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}"/>
  <link rel="stylesheet" href="{{ 'app.css' | asset }}">

  {# ── Bulletproof Self-Contained Luxury Design System ── #}
  <style>
    :root {
      --luxury-primary: {{ theme.settings.luxury_theme_palette|default('#141414') }};
      --luxury-accent: {{ theme.settings.luxury_secondary_accent|default('#C8A261') }};
      --luxury-accent-hover: #b38e4e;
      --luxury-bg: #FBFBF9;
      --luxury-surface: #FFFFFF;
      --luxury-border: #E8E5DF;
      --luxury-border-light: #F0ECE4;
      --luxury-text: #181716;
      --luxury-muted: #737069;
      --font-body: 'IBM Plex Sans Arabic', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-display: 'Cormorant Garamond', 'IBM Plex Sans Arabic', Georgia, serif;
      --color-primary: var(--luxury-primary);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--luxury-bg);
      color: var(--luxury-text);
      line-height: 1.6;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    .font-display {
      font-family: var(--font-display);
    }

    /* Container */
    .lux-container {
      width: 100%;
      max-width: 1280px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    /* Header */
    .lux-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--luxury-border);
      transition: all 0.3s ease;
    }

    .lux-header-inner {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .lux-nav-group {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .lux-logo {
      font-family: var(--font-display);
      font-size: 1.65rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--luxury-text);
      display: flex;
      align-items: center;
    }

    .lux-nav-links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      list-style: none;
    }

    .lux-nav-link {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--luxury-muted);
      letter-spacing: 0.02em;
    }

    .lux-nav-link:hover {
      color: var(--luxury-text);
    }

    .lux-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .lux-btn-pill {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--luxury-border);
      background: transparent;
      color: var(--luxury-text);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .lux-btn-pill:hover {
      border-color: var(--luxury-primary);
      background: var(--luxury-primary);
      color: #FFFFFF;
    }

    /* Hero Section */
    .lux-hero {
      position: relative;
      width: 100%;
      min-height: 580px;
      background: #0A0A0A;
      color: #FFFFFF;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    .lux-hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: 0.55;
    }

    .lux-hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(10,10,10,0.3) 0%, rgba(10,10,10,0.85) 100%);
    }

    .lux-hero-content {
      position: relative;
      z-index: 10;
      padding: 5rem 0;
      max-width: 780px;
    }

    .lux-eyebrow {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--luxury-accent);
      padding: 0.35rem 0.9rem;
      border: 1px solid rgba(200, 162, 97, 0.45);
      background: rgba(0, 0, 0, 0.6);
      margin-bottom: 1.25rem;
    }

    .lux-hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 5.5vw, 4rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 1.25rem;
      color: #FFFFFF;
    }

    .lux-hero-subtitle {
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.7;
      color: #E2DFD8;
      margin-bottom: 2.25rem;
      max-width: 620px;
    }

    .lux-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1rem 2.5rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      background: var(--luxury-accent);
      color: #0A0A0A;
      border: none;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    .lux-cta-btn:hover {
      background: #FFFFFF;
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.3);
    }

    /* Showcase Section */
    .lux-section {
      padding: 5rem 0;
    }

    .lux-section-header {
      display: flex;
      flex-direction: column;
      margin-bottom: 3rem;
    }

    @media (min-width: 768px) {
      .lux-section-header {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
      }
    }

    .lux-section-tag {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--luxury-accent);
      margin-bottom: 0.5rem;
    }

    .lux-section-title {
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 3.5vw, 2.5rem);
      font-weight: 700;
      color: var(--luxury-text);
      letter-spacing: -0.01em;
    }

    .lux-section-link {
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--luxury-text);
      border-bottom: 1px solid var(--luxury-text);
      padding-bottom: 0.2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .lux-section-link:hover {
      color: var(--luxury-accent);
      border-color: var(--luxury-accent);
    }

    /* Product Grid */
    .lux-product-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: 1.75rem;
    }

    @media (min-width: 640px) {
      .lux-product-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .lux-product-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .lux-card {
      background: var(--luxury-surface);
      border: 1px solid var(--luxury-border);
      display: flex;
      flex-direction: column;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lux-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.08);
      border-color: var(--luxury-accent);
    }

    .lux-card-media {
      position: relative;
      aspect-ratio: 3/4;
      background: #F4F1EA;
      overflow: hidden;
    }

    .lux-card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .lux-card:hover .lux-card-img {
      transform: scale(1.04);
    }

    .lux-card-badge {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 0.25rem 0.6rem;
      background: var(--luxury-primary);
      color: #FFFFFF;
    }

    .lux-card-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: space-between;
    }

    .lux-card-title {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--luxury-text);
      margin-bottom: 0.35rem;
      line-height: 1.4;
    }

    .lux-card-sub {
      font-size: 0.75rem;
      color: var(--luxury-muted);
      margin-bottom: 1rem;
    }

    .lux-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.85rem;
      border-top: 1px solid var(--luxury-border-light);
    }

    .lux-card-price {
      font-size: 1rem;
      font-weight: 700;
      color: var(--luxury-text);
    }

    /* Trust bar */
    .lux-trust-bar {
      border-top: 1px solid var(--luxury-border);
      border-bottom: 1px solid var(--luxury-border);
      padding: 3rem 0;
      background: #FFFFFF;
    }

    .lux-trust-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: 2rem;
      text-align: center;
    }

    @media (min-width: 768px) {
      .lux-trust-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .lux-trust-item h4 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
      color: var(--luxury-text);
    }

    .lux-trust-item p {
      font-size: 0.8125rem;
      color: var(--luxury-muted);
    }

    /* Footer */
    .lux-footer {
      background: var(--luxury-primary);
      color: #D1CEC7;
      padding: 4.5rem 0 2rem;
      margin-top: auto;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .lux-footer-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: 2.5rem;
      margin-bottom: 3.5rem;
    }

    @media (min-width: 768px) {
      .lux-footer-grid {
        grid-template-columns: 2fr 1fr 1fr;
      }
    }

    .lux-footer-brand h3 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      color: #FFFFFF;
      margin-bottom: 0.85rem;
    }

    .lux-footer-brand p {
      font-size: 0.875rem;
      color: #9C9890;
      max-width: 380px;
      line-height: 1.7;
    }

    .lux-footer-col h4 {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #FFFFFF;
      margin-bottom: 1.25rem;
    }

    .lux-footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .lux-footer-links a {
      font-size: 0.8125rem;
      color: #A6A29A;
    }

    .lux-footer-links a:hover {
      color: var(--luxury-accent);
    }

    .lux-footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 1.75rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font-size: 0.75rem;
      color: #737069;
    }

    @media (min-width: 640px) {
      .lux-footer-bottom {
        flex-direction: row;
      }
    }

    /* Skip link */
    .skip-to-content {
      position: absolute;
      top: -9999px;
      left: 1rem;
      z-index: 99999;
      background: var(--luxury-primary);
      color: #FFFFFF;
      padding: 0.75rem 1.5rem;
      border: 1px solid var(--luxury-accent);
    }

    .skip-to-content:focus {
      top: 1rem;
    }
  </style>

  {% block styles %}{% endblock %}
  {% hook 'head:end' %}
</head>
<body id="app" class="{% block body_class %}{% endblock %}">
  {% hook 'body:start' %}

  <a href="#main-content" class="skip-to-content">
    {{ trans('common.skip_to_content')|default('الانتقال إلى المحتوى الرئيسي') }}
  </a>

  {# ── Luxury Header ── #}
  <header role="banner" class="lux-header">
    <div class="lux-container lux-header-inner">
      <div class="lux-nav-group">
        <a href="{{ store.url|default('/') }}" class="lux-logo">
          {% if store.logo %}
            <img src="{{ store.logo }}" alt="{{ store.name }}" style="height: 36px; width: auto;" loading="eager">
          {% else %}
            <span>{{ store.name }}</span>
          {% endif %}
        </a>

        <nav role="navigation" aria-label="Main Navigation">
          <ul class="lux-nav-links" style="display: flex;">
            <li><a href="{{ link('home')|default('/') }}" class="lux-nav-link">{{ trans('common.home')|default('الرئيسية') }}</a></li>
            <li><a href="{{ link('categories')|default('/categories') }}" class="lux-nav-link">{{ trans('common.categories')|default('المجموعات') }}</a></li>
            <li><a href="{{ link('offers')|default('/offers') }}" class="lux-nav-link">{{ trans('common.offers')|default('العروض') }}</a></li>
          </ul>
        </nav>
      </div>

      <div class="lux-actions">
        <salla-search></salla-search>
        <a href="{{ user.language.code == 'ar' ? '?lang=en' : '?lang=ar' }}" class="lux-btn-pill">
          {{ user.language.code == 'ar' ? 'English' : 'عربي' }}
        </a>
        <salla-cart-summary></salla-cart-summary>
        <a href="{{ user.is_logged_in ? link('profile')|default('/profile') : link('login')|default('/login') }}" class="lux-btn-pill">
          {{ user.is_logged_in ? trans('common.my_account')|default('حسابي') : trans('common.login')|default('دخول') }}
        </a>
      </div>
    </div>
  </header>

  <main id="main-content" role="main" style="flex-grow: 1;">
    {% block content %}{% endblock %}
  </main>

  {# ── Luxury Footer ── #}
  <footer role="contentinfo" class="lux-footer">
    <div class="lux-container">
      <div class="lux-footer-grid">
        <div class="lux-footer-brand">
          <h3>{{ store.name }}</h3>
          <p>{{ store.description|default('تجربة تسوق راقية تجسد أعلى درجات الفخامة والأناقة المعاصرة.') }}</p>
        </div>
        <div class="lux-footer-col">
          <h4>{{ trans('common.customer_care')|default('خدمة العملاء') }}</h4>
          <ul class="lux-footer-links">
            <li><a href="{{ link('orders.tracking')|default('/orders/tracking') }}">{{ trans('common.track_order')|default('تتبع الطلب') }}</a></li>
            <li><a href="{{ link('pages', 'shipping')|default('/pages/shipping') }}">{{ trans('common.shipping_policy')|default('سياسة الشحن') }}</a></li>
            <li><a href="{{ link('pages', 'returns')|default('/pages/returns') }}">{{ trans('common.returns')|default('الإرجاع والاستبدال') }}</a></li>
          </ul>
        </div>
        <div class="lux-footer-col">
          <h4>{{ trans('common.payment_security')|default('الدفع الموثوق') }}</h4>
          <p style="font-size: 0.8125rem; color: #9C9890; line-height: 1.6; margin-bottom: 1rem;">
            {{ trans('common.secure_checkout_notice')|default('جميع المعاملات مشفرة ومحمية ببروتوكولات الأمان المعتمدة في منصة سلة.') }}
          </p>
          <div style="font-size: 0.75rem; color: var(--luxury-accent); letter-spacing: 0.05em;">
            MADA · VISA · MASTERCARD · APPLE PAY
          </div>
        </div>
      </div>

      <div class="lux-footer-bottom">
        <p>&copy; {{ "now"|date("Y") }} {{ store.name }}. {{ trans('common.all_rights_reserved')|default('جميع الحقوق محفوظة.') }}</p>
        <p>Luxury Pro · Powered by Salla Twilight</p>
      </div>
    </div>
  </footer>

  <script src="{{ 'app.js' | asset }}" defer></script>
  {% block scripts %}{% endblock %}
  {% hook 'body:end' %}
</body>
</html>
