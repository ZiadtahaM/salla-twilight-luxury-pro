<!DOCTYPE html>
<html lang="{{ user.language.code|default('ar') }}" dir="{{ user.language.dir|default('rtl') }}" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ store.name }} | {% block title %}{{ page.title|default('المتجر الرسمي') }}{% endblock %}</title>

  {# ── Salla platform injects: meta tags, OG tags, analytics, CSP ── #}
  {% hook 'head:start' %}
  {% hook head %}

  {# Google Fonts — CDN load is acceptable for fonts only #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  {# ── Compiled theme styles — webpack builds src/assets/styles/app.scss → public/app.css ── #}
  <link rel="stylesheet" href="{{ 'app.css' | asset }}">

  {# ── Merchant-overridden CSS custom properties from twilight.json settings ── #}
  <style>
    :root {
      --luxury-primary: {{ theme.settings.luxury_theme_palette|default('#1A1A1A') }};
      --luxury-accent:  {{ theme.settings.luxury_secondary_accent|default('#D4AF37') }};
      --luxury-bg:      {{ theme.settings.luxury_bg_color|default('#FAF9F6') }};
      --color-primary:  {{ theme.settings.luxury_theme_palette|default('#1A1A1A') }};
      --color-primary-dark:    #000000;
      --color-primary-light:   #3A3A3A;
      --color-primary-reverse: #FFFFFF;
    }
  </style>

  {% block styles %}{% endblock %}
  {% hook 'head:end' %}
</head>
<body class="flex flex-col min-h-screen {% block body_class %}{% endblock %}">
  {% hook 'body:start' %}

  <a href="#main-content" class="sr-only skip-to-content focus:not-sr-only">
    {{ trans('common.skip_to_content')|default('الانتقال إلى المحتوى الرئيسي') }}
  </a>

  {# ── Header — extracted component for reusability and editor support ── #}
  {% component 'header.header' %}

  <main id="main-content" role="main" class="flex-grow">
    {% block content %}{% endblock %}
  </main>

  {# ── Footer — extracted component ── #}
  {% component 'footer.footer' %}

  {# ── Compiled theme JS ── #}
  <script src="{{ 'app.js' | asset }}" defer></script>
  {% block scripts %}{% endblock %}

  {# ── Salla platform injects: cart drawer, login modal, toast notifications ── #}
  {% hook 'body:end' %}
</body>
</html>
