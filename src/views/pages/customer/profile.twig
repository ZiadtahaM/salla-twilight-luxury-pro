{% extends "layouts.master" %}
{% block title %}{{ trans('pages.profile')|default('ملفي الشخصي') }}{% endblock %}
{% block content %}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h1 class="text-2xl font-display font-semibold text-luxury-text mb-8">{{ trans('pages.profile')|default('ملفي الشخصي') }}</h1>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
    <a href="{{ link('orders')|default('/profile/orders') }}" class="p-6 border border-luxury-border hover:border-luxury-accent transition-colors group">
      <p class="text-xs uppercase tracking-wider text-luxury-muted mb-2">{{ trans('pages.my_orders')|default('طلباتي') }}</p>
      <p class="text-2xl font-display font-semibold text-luxury-text group-hover:text-luxury-accent transition-colors">{{ orders.count|default('0') }}</p>
    </a>
    <a href="{{ link('wishlist')|default('/wishlist') }}" class="p-6 border border-luxury-border hover:border-luxury-accent transition-colors group">
      <p class="text-xs uppercase tracking-wider text-luxury-muted mb-2">{{ trans('pages.wishlist')|default('المفضلة') }}</p>
      <p class="text-2xl font-display font-semibold text-luxury-text group-hover:text-luxury-accent transition-colors">{{ wishlist.count|default('0') }}</p>
    </a>
  </div>
  <div class="border border-luxury-border p-6 space-y-4">
    <h2 class="text-sm uppercase tracking-wider text-luxury-muted mb-4">{{ trans('pages.account_details')|default('بيانات الحساب') }}</h2>
    <div class="text-sm text-luxury-text"><span class="text-luxury-muted">{{ trans('common.name')|default('الاسم') }}: </span>{{ user.name }}</div>
    <div class="text-sm text-luxury-text"><span class="text-luxury-muted">{{ trans('common.email')|default('البريد') }}: </span>{{ user.email }}</div>
    {% if user.mobile %}<div class="text-sm text-luxury-text"><span class="text-luxury-muted">{{ trans('common.mobile')|default('الجوال') }}: </span>{{ user.mobile }}</div>{% endif %}
  </div>
  <div class="mt-6">
    <a href="{{ link('logout')|default('/logout') }}" class="text-sm text-luxury-muted hover:text-luxury-primary transition-colors">{{ trans('common.logout')|default('تسجيل الخروج') }}</a>
  </div>
</div>
{% endblock %}
