{% extends "layouts.master" %}
{% block title %}{{ trans('pages.my_orders')|default('طلباتي') }}{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h1 class="text-2xl font-display font-semibold text-luxury-text mb-8">{{ trans('pages.my_orders')|default('طلباتي') }}</h1>
  {% if orders.list is not empty %}
    <div class="space-y-4">
      {% for order in orders.list %}
        <a href="{{ order.url }}" class="flex items-center justify-between p-5 border border-luxury-border hover:border-luxury-accent transition-colors duration-200 group">
          <div>
            <span class="text-sm font-medium text-luxury-text">#{{ order.reference_id }}</span>
            <p class="text-xs text-luxury-muted mt-1">{{ order.date }}</p>
          </div>
          <div class="text-end">
            <span class="text-sm font-semibold text-luxury-text">{{ order.total.formatted }}</span>
            <p class="text-xs mt-1">
              <span class="inline-block px-2 py-0.5 text-[10px] uppercase tracking-wider border border-luxury-border text-luxury-muted">{{ order.status.name }}</span>
            </p>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="text-center py-20 text-luxury-muted">
      <p class="text-4xl mb-4">📦</p>
      <p>{{ trans('pages.no_orders')|default('لا توجد طلبات بعد.') }}</p>
      <a href="{{ link('home')|default('/') }}" class="btn-luxury-primary mt-6 inline-flex">{{ trans('common.start_shopping')|default('ابدأ التسوق') }}</a>
    </div>
  {% endif %}
</div>
{% endblock %}
