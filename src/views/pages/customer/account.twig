{#
  Template: customer/account.twig
  Scope: Salla Twilight Engine Customer Portal & VIP Profile
#}
{% extends "layouts.master" %}

{% block title %}
  {{ trans('common.my_account')|default('حساب العضوية الفاخرة') }} | {{ store.name }}
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 py-14">
  <div class="bg-white border border-stone-200 p-8 sm:p-10 shadow-sm">
    {# VIP Member Header #}
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pb-8 border-b border-stone-200">
      <div class="w-16 h-16 rounded-full bg-[#C5A059] text-stone-950 flex items-center justify-center font-serif text-2xl font-bold shadow-inner">
        {{ user.name|slice(0, 1)|default('N') }}
      </div>
      <div class="text-center sm:text-start flex-grow">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h1 class="text-2xl font-serif font-bold text-stone-900">
              {{ user.name|default('الأستاذ نايف الحربي') }}
            </h1>
            <p class="text-xs text-stone-500 mt-0.5">
              {{ user.email|default('naif@luxury.sa') }} | {{ user.mobile|default('+966 50 123 4567') }}
            </p>
          </div>
          <span class="inline-block px-3 py-1 bg-[#111111] text-[#C5A059] text-[11px] font-bold uppercase tracking-wider self-center sm:self-start">
            {{ trans('common.vip_tier')|default('عضوية النخبة الذهبية (VIP Reserve)') }}
          </span>
        </div>
      </div>
    </div>

    {# Salla User Profile / Tabs #}
    <div class="mt-8">
      <div class="flex gap-6 border-b border-stone-200 text-sm font-medium mb-6">
        <button class="pb-3 text-stone-900 border-b-2 border-[#C5A059] font-bold">
          {{ trans('common.orders_history')|default('سجل الطلبات والمقتنيات') }}
        </button>
        <button class="pb-3 text-stone-400 hover:text-stone-700">
          {{ trans('common.addresses')|default('العناوين المعتمدة') }}
        </button>
        <button class="pb-3 text-stone-400 hover:text-stone-700">
          {{ trans('common.wishlist')|default('قائمة الأمنيات (4)') }}
        </button>
      </div>

      {# Orders List #}
      <div class="space-y-4">
        <div class="p-5 border border-stone-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-stone-400 transition">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-sm text-stone-900 font-sans">#SL-884920</span>
              <span class="text-[10px] px-2 py-0.5 bg-amber-50 text-amber-800 font-semibold border border-amber-200">
                {{ trans('common.en_route')|default('قيد التوصيل الفوري') }}
              </span>
            </div>
            <p class="text-xs text-stone-500">
              عباية مخمل كشميري مطرزة + عطر العود الملكي المعتّق 100 مل
            </p>
            <span class="text-[11px] text-stone-400">28 سبتمبر 2026</span>
          </div>
          <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-2">
            <span class="font-bold text-sm text-stone-900">3,100.00 SAR</span>
            <a href="/order-tracking" class="text-xs text-[#C5A059] hover:underline font-semibold">
              {{ trans('common.track_order')|default('تتبع مسار الشحنة &larr;') }}
            </a>
          </div>
        </div>

        <div class="p-5 border border-stone-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 hover:border-stone-400 transition">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-sm text-stone-900 font-sans">#SL-771204</span>
              <span class="text-[10px] px-2 py-0.5 bg-emerald-50 text-emerald-800 font-semibold border border-emerald-200">
                {{ trans('common.delivered')|default('تم التسليم بنجاح') }}
              </span>
            </div>
            <p class="text-xs text-stone-500">
              حقيبة يد هيرمس كلاسيك جلد طبيعي
            </p>
            <span class="text-[11px] text-stone-400">14 أغسطس 2026</span>
          </div>
          <div class="flex sm:flex-col items-center sm:items-end justify-between w-full sm:w-auto gap-2">
            <span class="font-bold text-sm text-stone-900">3,400.00 SAR</span>
            <span class="text-xs text-stone-400">{{ trans('common.completed')|default('مكتمل') }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
