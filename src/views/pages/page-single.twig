{% extends "layouts.master" %}
{% block title %}{{ page.title }}{% endblock %}
{% block content %}
<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h1 class="text-2xl sm:text-3xl font-display font-semibold text-luxury-text mb-8 pb-6 border-b border-luxury-border">{{ page.title }}</h1>
  <div class="prose prose-stone max-w-none text-luxury-text/90 leading-relaxed">
    {{ page.content|raw }}
  </div>
</article>
{% endblock %}
