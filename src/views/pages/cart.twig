{#
  Template: cart.twig
  Scope: Salla Twilight Engine Shopping Cart Page
#}
{% extends "layouts.master" %}

{% block title %}
  {{ trans('common.cart')|default('سلة المشتريات الفاخرة') }} | {{ store.name }}
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h1 class="text-3xl font-serif font-bold text-stone-900 mb-8 pb-4 border-b border-stone-200">
    {{ trans('common.your_cart')|default('سلة مقتنياتك الفاخرة') }}
  </h1>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    {# Items List Area #}
    <div class="lg:col-span-8">
      {# Salla Native Cart Items Component #}
      <salla-cart-items></salla-cart-items>
      
      <div class="mt-8 flex items-center justify-between">
        <a href="/categories" class="text-xs uppercase tracking-wider font-semibold text-stone-700 hover:text-stone-950 flex items-center gap-2">
          <span>&larr;</span> {{ trans('common.continue_shopping')|default('العودة للتسوق والمجموعات') }}
        </a>
      </div>
    </div>

    {# Order Summary Sidebar #}
    <div class="lg:col-span-4">
      <div class="bg-white p-6 border border-stone-200 sticky top-24">
        <h3 class="font-serif text-lg font-bold text-stone-900 mb-4 pb-3 border-b border-stone-200">
          {{ trans('common.order_summary')|default('ملخص الطلب') }}
        </h3>

        {# Salla Native Cart Summary #}
        <salla-cart-summary></salla-cart-summary>

        {# Salla Loyalty & Discount Coupon #}
        <div class="my-6">
          <salla-discount-coupon></salla-discount-coupon>
        </div>

        {# Salla Checkout Button #}
        <salla-button 
          id="btn-checkout" 
          href="{{ salla_checkout_url() }}" 
          class="w-full h-12 bg-[#C5A059] hover:bg-[#b08e4d] text-stone-950 text-sm font-bold uppercase tracking-wider transition">
          {{ trans('common.proceed_to_checkout')|default('المتابعة لإتمام الدفع الفوري') }}
        </salla-button>

        <p class="text-[11px] text-stone-400 text-center mt-3">
          {{ trans('common.checkout_notice')|default('الدفع يتم بطريقة مشفرة وآمنة عبر بوابة سلة الوطنية.') }}
        </p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
