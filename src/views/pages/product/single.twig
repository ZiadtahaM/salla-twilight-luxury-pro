{#
  Template: product/single.twig
  Scope: Salla Twilight Engine Single Product Detail Page
#}
{% extends "layouts.master" %}

{% block title %}
  {{ product.name }} | {{ store.name }}
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  {# Breadcrumb #}
  <nav class="flex items-center gap-2 text-xs text-stone-500 mb-8" aria-label="Breadcrumb">
    <a href="/" class="hover:text-stone-900">{{ trans('common.home')|default('الرئيسية') }}</a>
    <span>/</span>
    <a href="/categories" class="hover:text-stone-900">{{ product.category.name|default('المجموعات الخاصة') }}</a>
    <span>/</span>
    <span class="text-stone-900 font-medium truncate">{{ product.name }}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
    {# Gallery Column #}
    <div class="lg:col-span-7">
      <salla-slider 
        id="product-gallery-slider" 
        class="product-gallery" 
        auto-play="false" 
        pagination="true" 
        show-controls="true">
        {% for image in product.images %}
          <div class="aspect-[3/4] bg-stone-100 overflow-hidden">
            <img 
              src="{{ image.url }}" 
              alt="{{ product.name }} - {{ loop.index }}" 
              class="w-full h-full object-cover object-center" 
              loading="{{ loop.first ? 'eager' : 'lazy' }}">
          </div>
        {% endfor %}
      </salla-slider>
    </div>

    {# Product Info & Purchase Column #}
    <div class="lg:col-span-5 flex flex-col justify-start">
      <div class="mb-4">
        {% if product.badge %}
          <span class="inline-block bg-[#111111] text-[#C5A059] text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 mb-2">
            {{ product.badge }}
          </span>
        {% endif %}
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 leading-tight">
          {{ product.name }}
        </h1>
        <p class="text-xs text-stone-400 mt-1 uppercase tracking-wider">
          SKU: {{ product.sku|default('ELITE-2026-X') }}
        </p>
      </div>

      {# Price & VAT Indicator #}
      <div class="flex items-baseline gap-3 my-4 pb-4 border-b border-stone-200">
        <span class="text-2xl font-bold text-stone-900 font-sans">
          {{ product.price|money }}
        </span>
        {% if product.is_on_sale %}
          <span class="text-base text-stone-400 line-through">
            {{ product.regular_price|money }}
          </span>
        {% endif %}
        <span class="text-xs text-stone-500">
          {{ trans('common.tax_included')|default('(شامل ضريبة القيمة المضافة)') }}
        </span>
      </div>

      {# Salla Installments Component (Tamara / Tabby) #}
      <div class="my-3">
        <salla-installments price="{{ product.price }}"></salla-installments>
      </div>

      {# Salla Options & Variants Selector #}
      <div class="my-4">
        <salla-product-options options="{{ product.options|json_encode }}"></salla-product-options>
      </div>

      {# Purchase Action Buttons #}
      <div class="flex flex-col gap-3 my-6">
        <salla-add-product-button 
          product-id="{{ product.id }}"
          class="w-full h-12 bg-[#111111] hover:bg-black text-white text-sm font-semibold tracking-wider uppercase transition">
          {{ trans('common.add_to_cart')|default('إضافة إلى سلة المقتنيات') }}
        </salla-add-product-button>
        
        <salla-button 
          type="button" 
          class="w-full h-12 bg-[#C5A059] hover:bg-[#b08e4d] text-stone-950 text-sm font-bold tracking-wider uppercase transition">
          {{ trans('common.buy_now')|default('شراء فوري عبر سلة برو') }}
        </salla-button>
      </div>

      {# Value Invariants #}
      <div class="bg-stone-50 p-4 border border-stone-200 text-xs text-stone-600 space-y-2 mb-6">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[#C5A059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>{{ trans('common.insured_shipping')|default('شحن فاخر مؤمن ومصفح خلال 24-48 ساعة داخل المملكة.') }}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[#C5A059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>{{ trans('common.authentic_guarantee')|default('ضمان أصالة المقتنيات بنسبة 100% مع شهادة اعتماد رقمية.') }}</span>
        </div>
      </div>

      {# Product Description & Specifications #}
      <div class="prose prose-stone text-sm leading-relaxed border-t border-stone-200 pt-6">
        {{ product.description|raw }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
