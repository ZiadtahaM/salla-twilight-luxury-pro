{% extends "layouts.master" %}
{% block title %}{{ trans('pages.brands')|default('الماركات') }}{% endblock %}
{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <header class="mb-12 text-center luxury-section-heading">
    <h1>{{ trans('pages.brands')|default('الماركات') }}</h1>
  </header>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
    {% for brand in brands.list %}
      <a href="{{ brand.url }}" class="flex flex-col items-center gap-3 p-4 border border-luxury-border hover:border-luxury-accent transition-colors duration-200 group">
        {% if brand.logo %}
          <img src="{{ brand.logo }}" alt="{{ brand.name }}" class="h-12 w-auto object-contain grayscale group-hover:grayscale-0 transition-all duration-300" loading="lazy">
        {% endif %}
        <span class="text-xs text-luxury-muted group-hover:text-luxury-text transition-colors text-center">{{ brand.name }}</span>
      </a>
    {% else %}
      <p class="col-span-full text-center text-luxury-muted py-16">{{ trans('pages.no_brands')|default('لا توجد ماركات.') }}</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
