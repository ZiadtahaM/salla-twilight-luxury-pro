{% extends "src/views/layouts/master.twig" %}

{% block title %}
  {{ store.name }} | الصفحة الرئيسية
{% endblock %}

{% block content %}
  {# Component rendering managed dynamically by Twilight Engine and Theme Editor #}
  {% component 'home.luxury-hero-banner' %}

  {# Curated Showcase Section #}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-xs uppercase tracking-widest text-amber-700 font-semibold mb-2 block">
          {{ trans('common.selected_pieces')|default('مختارات الموسم') }}
        </span>
        <h2 class="text-3xl font-bold tracking-tight text-stone-900" style="font-family: var(--font-display);">
          {{ trans('common.featured_products')|default('القطع الأكثر تميزاً') }}
        </h2>
      </div>
      <a href="/categories" class="mt-4 md:mt-0 text-sm font-medium text-stone-800 hover:text-amber-800 flex items-center gap-1 group">
        <span>{{ trans('common.view_all')|default('مشاهدة كافة المعروضات') }}</span>
        <span class="inline-block transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1">&larr;</span>
      </a>
    </div>

    {# Salla Native Products Slider or Grid Web Component #}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {% for product in products|slice(0, 4) %}
        <div class="group relative bg-white border border-stone-200 overflow-hidden flex flex-col justify-between">
          <div class="relative aspect-[3/4] bg-stone-100 overflow-hidden">
            <a href="{{ product.url }}" class="block w-full h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-600">
              <img 
                src="{{ product.image.url }}" 
                alt="{{ product.image.alt|default(product.name) }}" 
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="400"
                height="533"
              >
            </a>
            {% if product.promotion_title %}
              <span class="absolute top-3 start-3 bg-stone-900 text-white text-[10px] uppercase tracking-widest px-2.5 py-1">
                {{ product.promotion_title }}
              </span>
            {% endif %}
          </div>
          
          <div class="p-5 flex flex-col flex-grow justify-between">
            <div>
              <h3 class="text-sm font-medium text-stone-900 line-clamp-1 mb-1">
                <a href="{{ product.url }}" class="hover:underline">
                  {{ product.name }}
                </a>
              </h3>
              <p class="text-xs text-stone-500 mb-4 line-clamp-2">
                {{ product.subtitle|default(product.category.name) }}
              </p>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-stone-100">
              <span class="text-sm font-semibold text-stone-900">
                {{ product.price|money }}
              </span>
              {# Safe Salla Add To Cart Button Web Component #}
              <salla-add-product-button product-id="{{ product.id }}" product-status="{{ product.status }}" class="w-auto">
                <button type="button" class="text-xs font-semibold px-3 py-2 bg-stone-900 text-white hover:bg-stone-800 transition-colors">
                  {{ trans('common.add_to_cart')|default('إضافة للسلة') }}
                </button>
              </salla-add-product-button>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </section>
{% endblock %}
